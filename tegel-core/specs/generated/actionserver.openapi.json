          "name": {
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Name",
            "type": "string"
          },
          "optional": {
            "default": false,
            "title": "Optional",
            "type": "boolean"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "title": "ActionPort",
        "type": "object"
      },
      "Batch": {
        "description": "Response of ``POST /batches``.",
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "batch": {
            "minLength": 1,
            "title": "Batch",
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "title": "Runs",
            "type": "array"
          }
        },
        "required": [
          "batch",
          "action",
          "runs"
        ],
        "title": "Batch",
        "type": "object"
      },
      "BatchRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /batches``: exactly one non-selection input is a list.",
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "allow_transfer": {
            "default": false,
            "title": "Allow Transfer",
            "type": "boolean"
          },
          "force": {
            "default": false,
            "title": "Force",
            "type": "boolean"
          },
          "inputs": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Inputs",
            "type": "object"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "title": "BatchRequest",
        "type": "object"
      },
      "Capabilities": {
        "description": "What a server implements, returned by ``GET /capabilities``.",
