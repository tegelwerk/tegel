  "info": {
    "description": "Action routes of specs/actionserver.md (reference implementation tegel-actionserver 0.1.0).",
    "title": "Tegel action server",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actions": {
      "get": {
        "operationId": "list_actions_actions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ActionCard"
                  },
                  "title": "Response List Actions Actions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Actions"
      }
    },
