            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "inputs": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Inputs",
            "type": "object"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "phase": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunPhase"
              },
              {
                "type": "null"
              }
            ]
          },
          "principal": {
            "minLength": 1,
            "title": "Principal",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "started": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
