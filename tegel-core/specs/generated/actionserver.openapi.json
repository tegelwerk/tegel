          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "group",
          "name",
          "version"
        ],
        "title": "InstalledPlugin",
        "type": "object"
      },
      "Plan": {
        "additionalProperties": false,
        "description": "Response of ``POST /plans``, and the body of a ``409`` from ``POST /runs``.",
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "cached": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cached"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputPlan"
            },
            "title": "Inputs",
            "type": "array"
          },
          "moves_bytes": {
            "default": 0,
            "minimum": 0.0,
            "title": "Moves Bytes",
            "type": "integer"
          },
          "seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seconds"
          },
          "threshold_seconds": {
            "minimum": 0.0,
            "title": "Threshold Seconds",
            "type": "number"
          },
          "transfer_first": {
            "default": false,
            "title": "Transfer First",
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "action",
          "threshold_seconds"
        ],
        "title": "Plan",
        "type": "object"
      },
      "PortKind": {
        "description": "What an input or output port carries.",
        "enum": [
          "structure",
          "trajectory",
          "table",
          "array",
          "quantity",
          "json",
          "file",
          "selection"
        ],
        "title": "PortKind",
        "type": "string"
      },
      "Run": {
        "description": "One execution of one action version, as ``GET /runs/{run}`` returns it.",
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "batch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
