            "minLength": 1,
            "title": "Port",
            "type": "string"
          },
          "route": {
            "$ref": "#/components/schemas/InputRoute"
          },
          "seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seconds"
          },
          "size_bytes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "throughput_measured": {
            "default": false,
            "title": "Throughput Measured",
            "type": "boolean"
          },
          "uri": {
            "minLength": 1,
            "title": "Uri",
            "type": "string"
          }
        },
        "required": [
          "port",
          "uri",
          "route"
        ],
        "title": "InputPlan",
        "type": "object"
      },
      "InputRoute": {
        "description": "How the stage phase reads one input.",
        "enum": [
          "local",
          "tiled",
          "bytes",
          "bind"
        ],
        "title": "InputRoute",
        "type": "string"
      },
      "InstalledPlugin": {
        "description": "One entry point the server loaded.",
        "properties": {
          "group": {
            "minLength": 1,
            "title": "Group",
            "type": "string"
