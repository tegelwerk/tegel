            "title": "Schema Version"
          },
          "search_document": {
            "default": "ro-crate",
            "title": "Search Document",
            "type": "string"
          },
          "server_version": {
            "minLength": 1,
            "title": "Server Version",
            "type": "string"
          },
          "services": {
            "items": {
              "type": "string"
            },
            "title": "Services",
            "type": "array"
          },
          "spec_version": {
            "default": "0.4.0",
            "title": "Spec Version",
            "type": "string"
          }
        },
        "required": [
          "server_version"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
