        "type": "string"
      },
      "RunRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /runs`` and ``POST /plans``.\n\n``allow_transfer`` accepts a run whose plan moves more data than the server's\ntransfer threshold; without it such a request is refused with the plan.",
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "allow_transfer": {
            "default": false,
            "title": "Allow Transfer",
            "type": "boolean"
          },
          "force": {
            "default": false,
            "title": "Force",
            "type": "boolean"
          },
          "inputs": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Inputs",
            "type": "object"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
