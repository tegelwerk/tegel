            "type": "string"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/ActionPort"
            },
            "title": "Inputs",
            "type": "array"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/ActionPort"
            },
            "title": "Outputs",
            "type": "array"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "resources": {
            "items": {
              "type": "string"
            },
            "title": "Resources",
            "type": "array"
          },
          "scope": {
            "default": "actions:run",
            "minLength": 1,
            "title": "Scope",
            "type": "string"
          },
          "software": {
            "items": {
              "type": "string"
            },
            "title": "Software",
            "type": "array"
          },
          "title": {
            "default": "",
            "title": "Title",
            "type": "string"
          },
          "validity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validity"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "ActionCard",
        "type": "object"
      },
      "ActionPort": {
        "additionalProperties": false,
        "description": "One named input or output of an action.",
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PortKind"
