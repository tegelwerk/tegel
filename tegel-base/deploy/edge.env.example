PUBLIC_ORIGIN=
TEGEL_BIND=
TLS_MODE=terminate
PATH_DATA=/data
PATH_AUTH=/auth
PATH_PREFECT=/prefect
PORT_DATA=8000
PORT_AUTH=8080
PORT_PREFECT=4200
TEGEL_OUTPUT=
TEGEL_PROFILE=
TEGEL_SCHEMA_ROOT=
TEGEL_RECORDS=
TEGEL_ON_ERROR=skip
# Optional: host path of the upstreams YAML for remote data parts, and the
# secret variables it names (for example TEGEL_UPSTREAM_BEAMLINE_KEY=...).
TEGEL_UPSTREAMS=
