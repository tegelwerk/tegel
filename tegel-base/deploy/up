#!/bin/sh
set -eu
cd "$(dirname "$0")"
if [ ! -f edge.env ]; then
  echo "Copy edge.env.example to edge.env and set the public origin, bind, output, profile, schema root, and records." >&2
  exit 1
fi
set -a
# shellcheck disable=SC1091
. ./edge.env
set +a
for name in PUBLIC_ORIGIN TEGEL_BIND TLS_MODE PATH_DATA PATH_AUTH PATH_PREFECT PORT_DATA PORT_AUTH PORT_PREFECT TEGEL_OUTPUT TEGEL_PROFILE TEGEL_SCHEMA_ROOT TEGEL_RECORDS; do
  eval "value=\${$name-}"
  if [ -z "$value" ]; then
    echo "$name is required in edge.env" >&2
    exit 1
  fi
done
case "$TLS_MODE" in
  terminate|behind) ;;
  *)
    echo "TLS_MODE must be terminate or behind" >&2
    exit 1
    ;;
esac
PUBLIC_HOST=$(printf '%s' "$PUBLIC_ORIGIN" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#[:/].*##')
rest=$(printf '%s' "$PUBLIC_ORIGIN" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#^[^:/]*##')
case "$rest" in
  :*)
    CADDY_LISTEN=$(printf '%s' "$rest" | sed -e 's/^://' -e 's#/.*##')
    ;;
  *)
    case "$PUBLIC_ORIGIN" in
      https:*) CADDY_LISTEN=443 ;;
      http:*) CADDY_LISTEN=80 ;;
      *)
        echo "PUBLIC_ORIGIN must start with http:// or https://" >&2
        exit 1
        ;;
    esac
    ;;
esac
if [ "$TLS_MODE" = "behind" ]; then
  PUBLIC_HOST=edge-proxy
fi
export PUBLIC_HOST CADDY_LISTEN
TEGEL_SPEC_DIR=$(dirname "$TEGEL_PROFILE")
TEGEL_PROFILE_NAME=$(basename "$TEGEL_PROFILE")
export TEGEL_SPEC_DIR TEGEL_PROFILE_NAME
if [ -n "${TEGEL_UPSTREAMS-}" ]; then
  if [ ! -f "$TEGEL_UPSTREAMS" ]; then
    echo "TEGEL_UPSTREAMS is not a file: $TEGEL_UPSTREAMS" >&2
    exit 1
  fi
  TEGEL_UPSTREAMS_DIR=$(dirname "$TEGEL_UPSTREAMS")
  TEGEL_UPSTREAMS_IN=/upstreams/$(basename "$TEGEL_UPSTREAMS")
else
  TEGEL_UPSTREAMS_DIR=$TEGEL_OUTPUT/no-upstreams
  TEGEL_UPSTREAMS_IN=
fi
export TEGEL_UPSTREAMS_DIR TEGEL_UPSTREAMS_IN
mkdir -p "$TEGEL_OUTPUT" "$TEGEL_UPSTREAMS_DIR" tls
exec podman compose --env-file edge.env up --build "$@"
